#!/bin/sh
#
# @name HIL Fighter 4+1 VTOL (Makeflyeasy)
#
# @type Standard VTOL
# @class VTOL
#
# @output Motor1 MC motor front right (CCW)
# @output Motor2 MC motor back left (CCW)
# @output Motor3 MC motor front left (CW)
# @output Motor4 MC motor back right (CW)
# @output Motor5 Pusher motor
# @output Servo1 Left aileron
# @output Servo2 Right aileron
# @output Servo3 Left elevator
# @output Servo4 Right elevator
# @output Servo5 Rudder
#
# @board px4_fmu-v2 exclude
# @board bitcraze_crazyflie exclude
# @board holybro_kakutef7 exclude
#

. ${R}etc/init.d/rc.vtol_defaults

param set-default SYS_HITL 1
param set-default UAVCAN_ENABLE 0

param set-default COM_RC_IN_MODE 1
param set-default COM_PREARM_MODE 2

# Disable supply check to allow flight without real battery in HIL
param set-default CBRK_SUPPLY_CHK 894281

param set-default MAV_TYPE 22

# Disable motor failure detection (VTOL reports 0A for all ESCs in HIL)
param set-default FD_ACT_EN 0
param set-default FD_ACT_MOT_TOUT 500
param set-default FD_ESCS_EN 0

param set-default CA_AIRFRAME 2 # standard_vtol

# -------------------------------------------------------
# Rotor geometry (matches fighter_vtol/model.sdf poses)
# Positions in body frame: x=forward, y=right, z=down
# NOTE: CAD model faces -x; SDF model.sdf corrects this
#       so PX4 body frame aligns with gazebo world frame.
# -------------------------------------------------------
param set-default CA_ROTOR_COUNT 5

# rotor_0: front right (CCW, -z torque)
param set-default CA_ROTOR0_CT 85.0000
param set-default CA_ROTOR0_KM 0.0205
param set-default CA_ROTOR0_PX 0.4160
param set-default CA_ROTOR0_PY 0.5040

# rotor_1: back left (CCW, -z torque)
param set-default CA_ROTOR1_CT 85.0000
param set-default CA_ROTOR1_KM 0.0205
param set-default CA_ROTOR1_PX -0.4800
param set-default CA_ROTOR1_PY -0.5000

# rotor_2: front left (CW, +z torque)
param set-default CA_ROTOR2_CT 85.0000
param set-default CA_ROTOR2_KM -0.0205
param set-default CA_ROTOR2_PX 0.4200
param set-default CA_ROTOR2_PY -0.5000

# rotor_3: back right (CW, +z torque)
param set-default CA_ROTOR3_CT 85.0000
param set-default CA_ROTOR3_KM -0.0205
param set-default CA_ROTOR3_PX -0.4800
param set-default CA_ROTOR3_PY 0.5000

# rotor_pusher: tail pusher (+x thrust)
param set-default CA_ROTOR4_CT 80.0000
param set-default CA_ROTOR4_KM 0.0281
param set-default CA_ROTOR4_PX -1.0260
param set-default CA_ROTOR4_AX 1
param set-default CA_ROTOR4_AY 0
param set-default CA_ROTOR4_AZ 0

# -------------------------------------------------------
# Control surfaces (5 total: 2 aileron, 2 elevator, 1 rudder)
# -------------------------------------------------------
param set-default CA_SV_CS_COUNT 5

param set-default CA_SV_CS0_TYPE 1  # left aileron
param set-default CA_SV_CS0_TRQ_R -0.5

param set-default CA_SV_CS1_TYPE 2  # right aileron
param set-default CA_SV_CS1_TRQ_R 0.5

param set-default CA_SV_CS2_TYPE 3  # left elevator
param set-default CA_SV_CS2_TRQ_P 0.5

param set-default CA_SV_CS3_TYPE 3  # right elevator
param set-default CA_SV_CS3_TRQ_P 0.5

param set-default CA_SV_CS4_TYPE 4  # rudder
param set-default CA_SV_CS4_TRQ_Y 0.5

# -------------------------------------------------------
# HIL actuator function mapping
# HIL_ACT_FUNC(N) = function for controls[N-1] in HIL_ACTUATOR_CONTROLS
# Must match mavlink_interface control_channels in fighter_vtol_hitl.sdf:
#   index 0-4: motors, index 5-9: servos
# -------------------------------------------------------
param set-default HIL_ACT_FUNC1 101   # rotor_0_joint  (motor 1)
param set-default HIL_ACT_FUNC2 102   # rotor_1_joint  (motor 2)
param set-default HIL_ACT_FUNC3 103   # rotor_2_joint  (motor 3)
param set-default HIL_ACT_FUNC4 104   # rotor_3_joint  (motor 4)
param set-default HIL_ACT_FUNC5 105   # rotor_pusher_joint (motor 5)
param set-default HIL_ACT_FUNC6 201   # left_aileron_joint  (servo 1)
param set-default HIL_ACT_FUNC7 202   # right_aileron_joint (servo 2)
param set-default HIL_ACT_FUNC8 203   # left_elevator_joint (servo 3)
param set-default HIL_ACT_FUNC9 204   # right_elevator_joint (servo 4)
param set-default HIL_ACT_FUNC10 205  # rudder_joint         (servo 5)

# -------------------------------------------------------
# EKF / sensor init
# -------------------------------------------------------
param set-default EKF2_ANGERR_INIT 0.01
param set-default EKF2_GBIAS_INIT 0.01
param set-default EKF2_MAG_TYPE 1

# -------------------------------------------------------
# Fixed-wing controller
# -------------------------------------------------------
param set-default FW_AIRSPD_MAX 25.0
param set-default FW_AIRSPD_MIN 13.0
param set-default FW_AIRSPD_STALL 10.0
param set-default FW_AIRSPD_TRIM 18.0
param set-default FW_THR_TRIM 0.25
param set-default FW_THR_MAX 0.6
param set-default FW_THR_MIN 0.05
param set-default FW_PR_FF 0.2
param set-default FW_PR_P 0.9
param set-default FW_PSP_OFF 2
param set-default FW_P_LIM_MIN -15
param set-default FW_P_LIM_MAX 20.0
param set-default FW_RR_FF 0.1
param set-default FW_RR_P 0.3
param set-default FW_T_CLMB_MAX 2
param set-default FW_T_SINK_MAX 5
param set-default FW_T_SINK_MIN 2
param set-default FW_SERVICE_CEIL 3000.0
param set-default NPFG_PERIOD 12

# -------------------------------------------------------
# Multicopter controller
# -------------------------------------------------------
param set-default MC_AIRMODE 1
param set-default MC_ROLLRATE_P 0.3
param set-default MC_YAW_P 1.6

param set-default MPC_THR_HOVER 0.38
param set-default MPC_XY_P 0.8
param set-default MPC_XY_VEL_P_ACC 3
param set-default MPC_XY_VEL_I_ACC 4
param set-default MPC_XY_VEL_D_ACC 0.1
param set-default MPC_LAND_CRWL 0.5
param set-default MPC_XY_CRUISE 5.0
param set-default MPC_Z_VEL_MAX_UP 1.5
param set-default MPC_Z_VEL_MAX_DN 1.5

# -------------------------------------------------------
# VTOL transition
# -------------------------------------------------------
param set-default VT_TYPE 2
param set-default VT_F_TRANS_THR 1
param set-default VT_F_TRANS_DUR 4.0
param set-default VT_B_TRANS_DUR 3.0
param set-default VT_FWD_THRUST_EN 4
param set-default VT_PITCH_MIN -5
param set-default VT_ARSP_TRANS 14.0
param set-default VT_TRANS_TIMEOUT 20.0

# -------------------------------------------------------
# Mission / navigation
# -------------------------------------------------------
param set-default MIS_TAKEOFF_ALT 10
param set-default NAV_ACC_RAD 120
param set-default NAV_DLL_ACT 2

# -------------------------------------------------------
# Misc
# -------------------------------------------------------
param set-default BAT1_N_CELLS 12
param set-default SDLOG_DIRS_MAX 7
param set-default WV_EN 1
param set-default WEIGHT_BASE 11.5
param set-default WEIGHT_GROSS 11.5
